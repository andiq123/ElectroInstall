NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Firebase (client - used by /crm/login)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Realtime Database URL (Firebase Console → Realtime Database; overrides default *.firebaseio.com guess)
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# RTDB path where requests are stored
CRM_REQUESTS_RTD_PATH=crm_requests

# In Firebase Console → Realtime Database, under crm_admins add: { "<your-auth-uid>": true }
